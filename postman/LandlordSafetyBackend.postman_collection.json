          "name": "Get Region by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/regions/{{regionId}}"
          }
        },
        {
          "name": "Update Region",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Region Name\",\n  \"isActive\": true\n}"
            },
