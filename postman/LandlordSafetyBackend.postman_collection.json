              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"SecurePass1!\",\n  \"fullName\": \"Test Admin\",\n  \"role\": \"admin\",\n  \"phoneNumber\": \"07700900099\",\n  \"isActive\": true\n}"
            },
            "url": "{{baseUrl}}/api/users",
            "description": "Requires role: admin+. Roles: superAdmin, admin, technician"
          }
        },
