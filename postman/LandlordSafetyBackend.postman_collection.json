          }
        },
        {
          "name": "Replace Region Prefixes",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prefixes\": [\"SW1\", \"SW1A\", \"SW1W\"]\n}"
            },
