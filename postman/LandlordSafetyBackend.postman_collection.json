{
  "info": {
    "_postman_id": "landlord-safety-backend-api",
    "name": "Landlord Safety Backend",
    "description": "REST API for Landlord Safety Backend.\n\n**Setup**\n1. Import this collection (and optional environment).\n2. Set `baseUrl` (default `http://localhost:3000`).\n3. Run **Auth → Login** — the test script saves `token` automatically.\n4. Admin routes require role `admin` or `superAdmin`.\n\n**Response format:** `{ success, data, message, status }`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "regionId", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "bookingId", "value": "" },
    { "key": "quotationId", "value": "" },
    { "key": "quotationLineId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Health & Auth",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health",
            "description": "Public health check."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    if (json.data && json.data.token) {",
                  "        pm.collectionVariables.set('token', json.data.token);",
                  "        if (json.data.user && json.data.user.id) {",
                  "            pm.collectionVariables.set('userId', json.data.user.id);",
                  "        }",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"superadmin@landlordsafety.com\",\n  \"password\": \"ChangeMe123!\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Returns JWT in `data.token`. Test script stores it in collection variable `token`."
          }
        }
      ]
    },
    {
      "name": "Public — Catalog & Quotes",
      "item": [
        {
          "name": "Get Catalog (residential)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/catalog?propertyType=residential&postcode=SW1A%201AA",
              "host": ["{{baseUrl}}"],
              "path": ["api", "catalog"],
              "query": [
                { "key": "propertyType", "value": "residential", "description": "residential | commercial | installation" },
                { "key": "postcode", "value": "SW1A 1AA", "description": "Optional — enriches option prices" }
              ]
            },
            "description": "Categories, services, questions, bundles. Optional postcode resolves region pricing on options."
          }
        },
        {
          "name": "Get Catalog (commercial)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/catalog?propertyType=commercial",
              "host": ["{{baseUrl}}"],
              "path": ["api", "catalog"],
              "query": [{ "key": "propertyType", "value": "commercial" }]
            }
          }
        },
        {
          "name": "Get Catalog (installation)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/catalog?propertyType=installation",
              "host": ["{{baseUrl}}"],
              "path": ["api", "catalog"],
              "query": [{ "key": "propertyType", "value": "installation" }]
            }
          }
        },
        {
          "name": "Quote Preview (residential)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"propertyType\": \"residential\",\n  \"postcode\": \"SW1A 1AA\",\n  \"services\": [\n    {\n      \"code\": \"gsc\",\n      \"answers\": { \"applianceCount\": \"2\", \"coAlarmPresent\": \"yes\" }\n    }\n  ],\n  \"activeBundleKeys\": [\"bundle-gsc-boiler\"],\n  \"congestionZone\": false,\n  \"parkingAvailable\": true\n}"
            },
            "url": "{{baseUrl}}/api/quotes/preview",
            "description": "Live quote for residential; quote-on-request lines for commercial/installation."
          }
        },
        {
          "name": "Quote Preview (commercial)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"propertyType\": \"commercial\",\n  \"postcode\": \"E1 6AN\",\n  \"services\": [\n    {\n      \"code\": \"cp17\",\n      \"answers\": { \"applianceCount\": \"3\", \"gasInterlock\": \"yes\" }\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/quotes/preview"
          }
        },
        {
          "name": "Get Region Prices by Postcode",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/quotes/region-prices?postcode=SW1A%201AA",
              "host": ["{{baseUrl}}"],
              "path": ["api", "quotes", "region-prices"],
              "query": [{ "key": "postcode", "value": "SW1A 1AA" }]
            },
            "description": "Resolved region and price matrix for a postcode."
          }
        }
      ]
    },
    {
      "name": "Public — Bookings",
      "item": [
        {
          "name": "Create Booking (residential)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"propertyType\": \"residential\",\n  \"firstName\": \"James\",\n  \"lastName\": \"Smith\",\n  \"email\": \"james@example.com\",\n  \"phone\": \"07700900000\",\n  \"postcode\": \"SW1A 1AA\",\n  \"appointmentAddress\": \"10 High Street, London\",\n  \"preferredDate\": \"2026-06-01\",\n  \"preferredTimeSlot\": \"morning\",\n  \"accessProvider\": \"tenant\",\n  \"accessArrangements\": \"Key with agent\",\n  \"services\": [\n    {\n      \"code\": \"gsc\",\n      \"answers\": { \"applianceCount\": \"1\", \"coAlarmPresent\": \"yes\" }\n    }\n  ],\n  \"congestionZone\": false,\n  \"parkingAvailable\": true\n}"
            },
            "url": "{{baseUrl}}/api/bookings",
            "description": "BOOK NOW — persists booking, line items, and answers."
          }
        },
        {
          "name": "Create Quotation (residential TBC)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"propertyType\": \"residential\",\n  \"firstName\": \"Tbc\",\n  \"lastName\": \"User\",\n  \"email\": \"tbc@example.com\",\n  \"phone\": \"07700900003\",\n  \"postcode\": \"ZZ99 9ZZ\",\n  \"services\": [\n    {\n      \"code\": \"gsc\",\n      \"answers\": { \"applianceCount\": \"1\", \"coAlarmPresent\": \"yes\" }\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/quotations",
            "description": "Any TBC line → quotation with line items (serviceCode, serviceName)."
          }
        }
      ]
    },
    {
      "name": "Public — Quotations",
      "item": [
        {
          "name": "Create Quotation (commercial)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    if (json.data && json.data.id) {",
                  "        pm.collectionVariables.set('quotationId', json.data.id);",
                  "        const lines = json.data.lineItems || [];",
                  "        if (lines[0] && lines[0].id) pm.collectionVariables.set('quotationLineId', lines[0].id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"propertyType\": \"commercial\",\n  \"commercialPropertySubtype\": \"catering_hospitality\",\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Doe\",\n  \"email\": \"jane@example.com\",\n  \"phone\": \"07700900001\",\n  \"postcode\": \"E1 6AN\",\n  \"services\": [\n    {\n      \"code\": \"cp17\",\n      \"answers\": { \"applianceCount\": \"3\", \"gasInterlock\": \"yes\" }\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/quotations"
          }
        },
        {
          "name": "Create Quotation (alias quote-requests)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"propertyType\": \"commercial\",\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Doe\",\n  \"email\": \"jane@example.com\",\n  \"phone\": \"07700900001\",\n  \"postcode\": \"E1 6AN\",\n  \"services\": [{ \"code\": \"cp17\", \"answers\": {} }]\n}"
            },
            "url": "{{baseUrl}}/api/bookings/quote-requests",
            "description": "Deprecated alias → POST /api/quotations"
          }
        }
      ]
    },
    {
      "name": "Dashboard (Admin)",
      "description": "Requires Bearer token and role `admin`+.",
      "item": [
        {
          "name": "Get Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/dashboard/stats",
            "description": "Active technicians, pending bookings, current month completed count and revenue."
          }
        }
      ]
    },
    {
      "name": "Users",
      "description": "Authenticated. List/create/update require role `admin`. Delete requires `superAdmin`.",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users/me"
          }
        },
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users",
            "description": "Requires role: admin+"
          }
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users/{{userId}}",
            "description": "Requires role: admin+"
          }
        },
        {
          "name": "Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    if (json.data && json.data.id) {",
                  "        pm.collectionVariables.set('userId', json.data.id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
