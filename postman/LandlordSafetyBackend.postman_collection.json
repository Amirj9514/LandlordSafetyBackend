        {
          "name": "Upsert Region Prices",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prices\": [\n    { \"tierKey\": \"gsc_meter_1\", \"amount\": 59.99 },\n    { \"tierKey\": \"gsc_meter_2\", \"amount\": 74.99 }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/regions/{{regionId}}/prices",
            "description": "Use `amount: null` for TBC. Each item needs `tierKey` or `pricingTierId`."
          }
        },
        {
          "name": "Delete Region",
