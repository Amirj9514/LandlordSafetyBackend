    },
    {
      "name": "Quotations (Admin)",
      "description": "Requires Bearer token and role `admin`+. Line items include serviceCode and serviceName.",
      "item": [
        {
          "name": "List Quotations",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    const rows = json.data && json.data.quotations;",
                  "    if (Array.isArray(rows) && rows[0] && rows[0].id) {",
                  "        pm.collectionVariables.set('quotationId', rows[0].id);",
                  "        if (rows[0].lineItems && rows[0].lineItems[0]) {",
                  "            pm.collectionVariables.set('quotationLineId', rows[0].lineItems[0].id);",
                  "        }",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/quotations?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "quotations"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Get Quotation by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/quotations/{{quotationId}}"
          }
        },
        {
          "name": "Update Quotation Line Prices",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lines\": [\n    {\n      \"id\": \"{{quotationLineId}}\",\n      \"unitPrice\": 59.99,\n      \"total\": 59.99,\n      \"isTbc\": false\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/quotations/{{quotationId}}/lines"
          }
        },
        {
          "name": "Update Quotation Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"priced\"\n}"
            },
            "url": "{{baseUrl}}/api/quotations/{{quotationId}}/status"
          }
        },
        {
          "name": "Convert Quotation to Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    if (json.data && json.data.id) pm.collectionVariables.set('bookingId', json.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/quotations/{{quotationId}}/convert",
            "description": "All lines must be priced (no isTbc)."
          }
        }
      ]
    },
    {
      "name": "Bookings (Admin)",
      "description": "Requires Bearer token and role `admin`+.",
      "item": [
        {
          "name": "List Bookings",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    const data = json.data;",
                  "    const bookings = data && (data.bookings || data.items || data);",
                  "    if (Array.isArray(bookings) && bookings.length > 0 && bookings[0].id) {",
                  "        pm.collectionVariables.set('bookingId', bookings[0].id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/bookings?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "propertyType", "value": "residential", "disabled": true },
                { "key": "status", "value": "pending", "disabled": true },
                { "key": "paymentStatus", "value": "unpaid", "disabled": true }
              ]
            },
            "description": "Lists bookings and recent quotations."
          }
        },
        {
          "name": "List Technicians",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    if (Array.isArray(json.data) && json.data[0] && json.data[0].id) {",
                  "        pm.collectionVariables.set('technicianUserId', json.data[0].id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/bookings/technicians/list",
            "description": "Active users with role technician."
          }
        },
        {
          "name": "Get Booking by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/bookings/{{bookingId}}",
            "description": "Detail with line items, technician, statusHistory."
          }
        },
        {
          "name": "Update Booking (confirm + assign technician)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"confirmed\",\n  \"technicianId\": \"{{technicianUserId}}\",\n  \"adminNotes\": \"Confirmed by admin\"\n}"
            },
            "url": "{{baseUrl}}/api/bookings/{{bookingId}}"
          }
        },
        {
          "name": "Update Booking (complete)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"completed\"\n}"
            },
            "url": "{{baseUrl}}/api/bookings/{{bookingId}}"
          }
        },
        {
          "name": "Update Booking (cancel)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"cancelled\",\n  \"adminNotes\": \"Cancelled by customer request\"\n}"
            },
            "url": "{{baseUrl}}/api/bookings/{{bookingId}}"
          }
        },
        {
          "name": "Update Booking (mark paid)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentStatus\": \"paid\"\n}"
            },
            "url": "{{baseUrl}}/api/bookings/{{bookingId}}",
            "description": "Sets paymentStatus to paid and paidAt to now. Admin/superAdmin only."
          }
        },
        {
          "name": "Update Booking (mark unpaid)",
          "request": {
