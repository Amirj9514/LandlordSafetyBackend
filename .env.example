NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://user:password@host:5432/database_name

JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# First super admin (used by db:seed only)
SEED_SUPER_ADMIN_EMAIL=superadmin@landlordsafety.com
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!
SEED_SUPER_ADMIN_FULL_NAME=Super Admin

# Pricing (optional)
VAT_ENABLED=false
VAT_RATE=0.2

# Set to true to log SQL queries (off by default)
DB_LOGGING=false

# Set to true to auto-alter tables on every server start (slow; use npm run db:sync instead)
DB_SYNC_ALTER=false
